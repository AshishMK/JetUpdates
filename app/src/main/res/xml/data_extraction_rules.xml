<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude Room databases -->
        <exclude domain="database" path="." />

        <!-- Exclude datastore subfolder (no trailing slash) -->
        <exclude domain="file" path="datastore" />

        <!-- Fallback: Exclude all files directly in filesDir -->
        <exclude domain="file" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>