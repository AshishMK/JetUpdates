"""
Representing a color value comprising of HEX, RGBA and css color values
"""
type Color {
  hex: Hex!

  rgba: RGBA!

  css: String!
}

"""
Accepts either HEX or RGBA color value. At least one of hex or rgba value should be passed. If both are passed RGBA is used.
"""
input ColorInput {
  hex: Hex

  rgba: RGBAInput
}

